{#
  VERTICAL PAGE: "magazine" template (Sanity vertical with Page layout = magazine).

  Wired to verticalData (src/_data/verticalData.js). The key is "<lang>/<slug>" of
  the vertical, e.g. verticalData["en/classroom"].
    items[0]          featured overlay story
    items[1..3]       three headlines beside it
    items[4..]        standard feed (tag, headline, summary, thumbnail)
    picks             sidebar list: Featured stories of the vertical, else the newest
  Ad units stay static. With no stories the page shows a "no stories yet" message.
#}
{% set secKey = vertical.lang ~ '/' ~ vertical.slug %}
{% set sd = verticalData[secKey] %}
{% set items = sd.articles if sd else [] %}
{% set picks = sd.picks if sd else [] %}
{% set lead = items[0] %}
{% set side = items.slice(1, 4) %}
{% set feed = items.slice(4) %}

<section class="news-article category-section">
  <div class="article-container">

    <!-- Top Leaderboard Ad -->
    <div class="ad-unit ad-leaderboard">
      <span class="ad-label">{% if vertical.lang == 'ar' %}إعلان{% else %}Advertisement{% endif %}</span>
      <div class="ad-container">
        <span class="ad-placeholder-text">{% if vertical.lang == 'ar' %}إعلان 728x90{% else %}ADVERTISEMENT 728x90{% endif %}</span>
      </div>
    </div>

    <!-- Main Content Layout Grid -->
    <div class="article-layout">

      <!-- Primary Category Content Column -->
      <main class="article-main">

        <!-- Category Header -->
        <header class="sec-head">
          <h1 class="sec-head-title">{{ vertical.title }}</h1>
        </header>

        {% if vertical.description %}
        <p class="category-description" style="color: #666; margin-bottom: 24px; font-size: 1.1rem;">
          {{ vertical.description }}
        </p>
        {% endif %}

        {% if lead %}
        <!-- Featured Category Articles (Duo Section) -->
        <div class="duo-section">
          <!-- Main Highlight -->
          <div class="duo-main">
            <a href="{{ lead.url }}" class="overlay-card">
              <img src="{{ lead.imageUrl or '/assets/img/placeholder.png' }}" alt="{{ lead.imageAlt or lead.title }}">
              <h3 class="overlay-title">{{ lead.title }}</h3>
            </a>
          </div>

          <!-- Secondary Highlights -->
          {% if side.length %}
          <div class="duo-side story-list">
            {% for s in side %}
            <article class="story-row">
              <h4 class="story-title story-title-sm"><a href="{{ s.url }}">{{ s.title }}</a></h4>
            </article>
            {% endfor %}
          </div>
          {% endif %}
        </div>

        {% if feed.length %}
        <!-- Standard Category Feed -->
        <div class="story-list story-list-roomy" style="margin-top: 32px;">
          {% for a in feed %}
          <article class="story-row">
            <div class="story-title story-title-md">
              <span class="pick-tag">{{ a.tag }}</span>
              <a href="{{ a.url }}">{{ a.title }}</a>
              {% if a.summary %}<p class="story-excerpt">{{ a.summary }}</p>{% endif %}
            </div>
            <a href="{{ a.url }}" class="story-thumb story-media ratio-3x2">
              <img src="{{ a.imageUrl or '/assets/img/placeholder.png' }}" alt="{{ a.imageAlt or a.title }}">
            </a>
          </article>
          {% endfor %}
        </div>
        {% endif %}

        {% else %}
        <p class="category-empty" style="color: #666; margin: 40px 0; font-size: 1.05rem;">
          {% if vertical.lang == 'ar' %}لا توجد مقالات في هذا القسم بعد.{% else %}No stories in this vertical yet.{% endif %}
        </p>
        {% endif %}

      </main>

      <!-- Sidebar: Widgets + Sticky Ad -->
      <aside class="article-sidebar">
        <div class="sticky-sidebar">

          <!-- Top stories: Featured stories of this category, else the newest.
               (There is no page-view data yet, so this is not a "most read" list.) -->
          {% if picks.length %}
          <div class="sidebar-widget" style="margin-bottom: 32px;">
            <h4 class="section-title-sm">{% if vertical.lang == 'ar' %}اختيارات المحررين في القسم{% else %}Editors' Picks{% endif %}</h4>
            <div class="most-read-list" style="margin-top: 16px;">
              {% for p in picks %}
              <article class="most-read-item">
                <span class="mr-number">{{ loop.index }}</span>
                <div class="mr-body">
                  <h4><a href="{{ p.url }}">{{ p.title }}</a></h4>
                </div>
              </article>
              {% endfor %}
            </div>
          </div>
          {% endif %}

          <!-- Sticky Half-Page Ad Unit -->
          <div class="ad-unit ad-halfpage">
            <span class="ad-label">{% if vertical.lang == 'ar' %}إعلان{% else %}Advertisement{% endif %}</span>
            <div class="ad-container">
              <span class="ad-placeholder-text">{% if vertical.lang == 'ar' %}إعلان 300x600{% else %}ADVERTISEMENT 300x600{% endif %}</span>
            </div>
          </div>

        </div>
      </aside>

    </div>
  </div>
</section>
