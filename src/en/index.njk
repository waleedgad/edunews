 <!-- ==========================================
     SECTION: SIGNATURE SERIES (expanding panels)
     ========================================== -->
{#
  Wired to home.signature: newest In-Depth Reports (Content Format = "In-Depth Report").
  Panel label = category name. Hidden when there are no reports.
#}
{% set sigItems = home.signature %}
{% if sigItems and sigItems.length %}
<section class="sig mb-5" aria-labelledby="sig-heading">

    <header class="sig-head">
        <div class="sig-head-text">
            <span class="sig-eyebrow">EduNews</span> · Special Report
            <h2 class="sig-heading" id="sig-heading">Signature Series</h2>
        </div>
        <a href="/en/series/" class="sig-more">More <i class="bi bi-arrow-right"></i></a>
    </header>

    <div class="sig-row">
        {% for p in sigItems %}
        <a href="{{ p.url }}" class="sig-panel{% if loop.first %} is-active{% endif %}">
            <img class="sig-panel-img" src="{{ p.imageUrl or '/assets/img/placeholder.png' }}" alt="{{ p.imageAlt or p.title }}" loading="lazy">
            <span class="sig-panel-no" aria-hidden="true"></span>
            <span class="sig-panel-label" aria-hidden="true">{{ p.category.title if p.category else p.title }}</span>
            <div class="sig-panel-body">
                <span class="sig-brand">
                    <span class="sig-brand-main">Edu<span>News</span></span>
                    <span class="sig-brand-sub">Special Report</span>
                </span>
                <h3 class="sig-panel-title">{{ p.title }}</h3>
                <span class="sig-panel-cta">Read the report <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Touch devices have no hover: first tap opens a panel, second tap follows the link.
   Mouse and keyboard need no JS (pure CSS). Move this into your main JS if you prefer. #}
<script>
(function () {
    var row = document.querySelector('.sig-row');
    if (!row) return;
    var panels = Array.prototype.slice.call(row.querySelectorAll('.sig-panel'));
    var touch = window.matchMedia('(hover: none)');
    row.addEventListener('click', function (e) {
        var p = e.target.closest('.sig-panel');
        if (!p || !touch.matches || p.classList.contains('is-active')) return;
        e.preventDefault();
        panels.forEach(function (x) { x.classList.toggle('is-active', x === p); });
    });
})();
</script>



